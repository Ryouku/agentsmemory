package views

import "strconv"

// DashboardPage lists the user's projects and offers the "create free project"
// control. The create flow is datastar-driven: the button posts the bound
// projectName signal to /projects, and the server streams back patched
// fragments for #flash (the one-time key) and #projects (the refreshed list).
templ DashboardPage(d DashboardData) {
	@Layout("Projects", d.UserEmail) {
		<section class="page-head">
			<p class="eyebrow">Dashboard</p>
			<h1>Your projects</h1>
			<p>Each project is an isolated memory workspace your agents reach over MCP with a bearer token.</p>
			if d.IsSuperAdmin {
				// Platform control, shown only to superadmins: edit the global am_skillset
				// playbook every workspace's agents wake up with.
				<p class="meta-row">
					<a class="link-arrow" href="/superadmin/skillset">
						Edit the global wakeup skillset
						<span aria-hidden="true">→</span>
					</a>
				</p>
			}
		</section>
		@Flash(d.Flash)
		<div class="card create" data-signals="{projectName: ''}">
			<div class="field">
				<label for="projectName">New free project</label>
				<input
					class="input"
					id="projectName"
					data-bind:project-name
					placeholder="e.g. acme-research"
					data-on:keydown="evt.key === 'Enter' && @post('/projects')"
				/>
			</div>
			<button
				class="btn btn-primary"
				data-on:click="@post('/projects')"
				data-indicator:creating
				data-attr:disabled="$creating"
			>
				<span data-show="!$creating">Create free project</span>
				<span class="spinner" data-show="$creating" style="display:none" aria-hidden="true"></span>
			</button>
		</div>
		@ProjectsList(d.Projects)
	}
}

// ProjectsList renders the project grid or an empty state. Its root carries the
// stable id="projects" so datastar's PatchElements can morph it on creation —
// the patched fragment must carry the target id itself, not a wrapper.
templ ProjectsList(projects []ProjectVM) {
	<div id="projects">
		if len(projects) == 0 {
			<div class="card empty">
				<h3>No projects yet</h3>
				<p>Create your first free project to get an MCP endpoint and an API key.</p>
			</div>
		} else {
			<div class="grid">
				for _, p := range projects {
					@ProjectCard(p)
				}
			</div>
		}
	</div>
}

// ProjectCard shows one project: its plan badge, API key (revealed once on
// creation, masked thereafter), and the monthly request usage bar.
//
// A workspace usually holds only 2–3 projects, so each card spans the full row
// (see .grid in app.css) rather than competing in a narrow auto-fill column —
// that gives the revealed API key and the `claude mcp add` command room to sit
// on a comfortable line instead of being squeezed and wrapped. To stop the wide
// card reading as sparse, the body splits into two columns on wider screens
// (.project-body): the key + command on the left where the width is needed,
// the compact usage meter on the right rail. The "Manage project" action stays a
// full-width footer so its affordance and divider span the whole card.
templ ProjectCard(p ProjectVM) {
	<article class="project card">
		<div class="project-top">
			<div>
				<h3>{ p.Name }</h3>
				@SlugChip(p.Slug)
			</div>
			<span class="badge">{ p.PlanName }</span>
		</div>
		<div class="project-body">
			<div class="project-main">
				@KeyBlock(KeyVM{TeamID: p.TeamID, CanReveal: p.CanReveal})
			</div>
			<div class="project-side">
				<div class="usage">
					<div class="usage-head">
						<span class="kv" style="margin:0">Requests this month</span>
						<span class="nums">{ strconv.Itoa(p.Used) } / { capLabel(p) }</span>
					</div>
					<div class={ barClass(p) }>
						<span
							style={ "width:" + strconv.Itoa(p.Pct) + "%" }
							role="progressbar"
							aria-label="Monthly request usage"
							aria-valuenow={ strconv.Itoa(p.Used) }
							aria-valuemin="0"
							aria-valuemax={ strconv.Itoa(p.Cap) }
						></span>
					</div>
				</div>
			</div>
		</div>
		<div class="project-foot">
			<a class="link-arrow" href={ templ.SafeURL("/projects/" + p.TeamID) }>
				Manage project
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</article>
}

// SlugChip surfaces a workspace's slug as a labeled, one-click-copyable handle —
// the identifier another workspace's owner types into "Share a wing" to push
// memory here. Before this the slug was printed as faint, unlabeled mono text
// that read as decoration, so owners couldn't tell it apart as the thing to hand
// over and the cross-tenant share handshake had no starting point.
//
// The whole chip is the copy button (lowest friction: grab slug -> paste), and
// the copied confirmation is scoped to the clicked element via el.classList, NOT
// a datastar signal: the dashboard renders one chip per project card and signals
// are global, so a shared _copied would flash "Copied ✓" on every card at once —
// the same trap KeyBlock documents. el keeps each chip independent, so this works
// unchanged whether the page shows one chip (project header) or many (dashboard).
templ SlugChip(slug string) {
	<button
		type="button"
		class="slug-chip"
		title="Copy workspace slug"
		aria-label={ "Copy workspace slug " + slug }
		data-on:click={ copyExpr(slug) + "; el.classList.add('is-copied'); setTimeout(() => el.classList.remove('is-copied'), 1600)" }
	>
		<span class="slug-chip-tag">slug</span>
		<span class="slug-chip-val">{ slug }</span>
		<span class="slug-chip-act" aria-hidden="true">
			<span class="slug-chip-copy">Copy</span>
			<span class="slug-chip-done">Copied ✓</span>
		</span>
	</button>
}

// KeyBlock renders a project's API key area as a datastar morph target
// (id "key-<TeamID>"). It starts masked; an admin's Reveal button fetches the
// decrypted secret into the revealed state (Copy + Hide), and Hide re-masks —
// both via the server so one fragment owns the markup. Members see only the
// masked state (no Reveal control), and the server refuses a reveal for them
// regardless of the UI. No data-indicator here on purpose: datastar signals are
// global, so a shared "revealing" signal would spin every card's button at once.
templ KeyBlock(k KeyVM) {
	<div id={ "key-" + k.TeamID } class="keybox">
		<div class="kv">API key</div>
		if k.Revealed {
			<code class="token">{ k.Secret }</code>
			if k.Rotated {
				<div class="key-note" role="status">Key rotated — the previous key was revoked and has stopped working. Copy the new one now.</div>
			}
			<div class="key-actions">
				<button class="btn btn-ghost btn-sm" type="button" data-on:click={ copyExpr(k.Secret) }>Copy</button>
				<button class="btn btn-ghost btn-sm" type="button" data-on:click={ "@get('/projects/" + k.TeamID + "/key?reveal=0')" }>Hide</button>
			</div>
			// The revealed token is the bearer /mcp accepts directly, so offer the
			// one-paste install command right here. Only the full installer is shown
			// (not a bare `claude mcp add`): the installer also wires the slash
			// commands, Stop hook, and auto-loaded CLAUDE.md that MCP registration
			// alone would miss.
			@InstallBlock(k.TeamID, k.Secret)
		} else if k.ConfirmRotate {
			<div class="token muted">••••••••••••••••••••••••</div>
			<div class="key-warn" role="alert">
				Rotating issues a new key and <b>revokes the current one</b> — any agent still using the old key will stop working.
			</div>
			<div class="key-actions">
				<button class="btn btn-primary btn-sm" type="button" data-on:click={ "@post('/projects/" + k.TeamID + "/key/rotate')" }>Confirm rotate</button>
				<button class="btn btn-ghost btn-sm" type="button" data-on:click={ "@get('/projects/" + k.TeamID + "/key?reveal=0')" }>Cancel</button>
			</div>
		} else {
			<div class="token muted">••••••••••••••••••••••••</div>
			if k.CanReveal {
				<div class="key-actions">
					<button class="btn btn-ghost btn-sm" type="button" data-on:click={ "@get('/projects/" + k.TeamID + "/key?reveal=1')" }>Reveal</button>
					<button class="btn btn-ghost btn-sm" type="button" data-on:click={ "@get('/projects/" + k.TeamID + "/key?confirm=rotate')" }>Rotate</button>
				</div>
			}
		}
		if k.Error != "" {
			<div class="key-error" role="alert">{ k.Error }</div>
		}
	</div>
}

// Flash renders a transient success or error banner. Its root always carries
// id="flash" (even when empty) so it is a stable datastar morph target —
// patching it with an empty Flash clears any prior message.
templ Flash(f FlashVM) {
	<div id="flash">
		if f.Kind == "success" {
			<div class="flash success" role="status">
				<div class="ttl">{ f.Message }</div>
				if f.ClientKey != "" {
					<div class="kv" style="margin-top:.6rem">OAuth Client ID</div>
					<div class="token">{ f.ClientKey }</div>
				}
				if f.Token != "" {
					<div class="kv" style="margin-top:.6rem">Secret / API key — shown once</div>
					<div class="token">{ f.Token }</div>
				}
				// On creation the token is shown once here, so hand over the ready-to-run
				// install command in the same banner — navigating away loses the secret.
				// The creation banner is a singleton, so it gets a fixed signal
				// namespace of its own rather than a workspace id it does not carry.
				if f.Token != "" {
					@InstallBlock("new", f.Token)
				}
			</div>
		} else if f.Kind == "error" {
			<div class="flash error" role="alert">
				<div class="ttl">{ f.Message }</div>
			</div>
		} else if f.Kind == "note" {
			<div class="flash note" role="status">
				<div class="ttl">{ f.Message }</div>
			</div>
		}
	</div>
}

// InstallBlock renders the install picker for one workspace, with this project's
// token already in the command. It is the single connect affordance: the whole kit
// (slash commands, Stop hook, auto-loaded CLAUDE.md and the MCP) rather than a bare
// `claude mcp add`, which would register the MCP and miss the rest.
//
// TWO THINGS THIS BLOCK MUST GET RIGHT:
//
// The token is embedded via AGENTSMEMORY_TOKEN, so unlike the public page's copy
// this command never stops to prompt. The secret is the one already revealed
// beside this block, so embedding it exposes nothing new — and it is why the
// builder belongs here at all: a signed-in user can get a complete, sandboxed,
// non-interactive install in one paste.
//
// The signals are namespaced per workspace. Several projects' key blocks can be
// revealed at once and datastar signals are global (the same trap KeyBlock
// documents for its indicator), so a shared "_sbname" would mean naming a sandbox
// under one project silently rewrote another project's command.
templ InstallBlock(teamID, token string) {
	{{ b := projectBuilder(teamID, token) }}
	<div class="lp-build install-build" data-signals={ b.Signals() }>
		<div class="kv">Install the kit</div>
		@installPlatformTabs(b)
		// Gated as one unit — see the identical wrapper on the landing page for why
		// the class matters to app.css.
		<div class="lp-build-cli" data-show={ b.PlatIs(platUnix) }>
			@installTabs(b)
			@installOptions(b)
			@installFlags(b)
			@installCommand(b)
			<p class="lp-build-note install-build-hint">
				Restart Claude Code (or <span class="mono">/reload</span>) afterwards. The token
				above is already in the command, so this install will not prompt.
			</p>
			// Only the launch line, not the landing page's full init/load walkthrough:
			// someone reading this already has the product and needs the one command
			// that opens what they just installed. It lives INSIDE the CLI wrapper:
			// its own gate is the mode, so on its own it would survive a switch to the
			// Windows tab and offer a CLI command to someone who has no CLI.
			<div class="install-build-run" data-show={ b.ModeIs("project") } style="display:none">
				<div class="lp-code card">
					<div class="lp-code-head">
						<span class="kv">then open it</span>
						@sbCopyButtonExpr(clipboardExprKeyJS(b.RunExpr(), "run"+b.Suffix), "run"+b.Suffix, "Copy the command that opens this sandbox")
					</div>
					<pre class="cmd"><code data-text={ b.RunExpr() }>aiagentmemory run { landingNameFallback }</code></pre>
				</div>
			</div>
		</div>
		<div class="lp-build-cli" data-show={ b.PlatIs(platWin) } style="display:none">
			@installWindowsPanel(b)
		</div>
	</div>
}
