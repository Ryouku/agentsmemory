# agentsmemory — configuration for the self-hosted (--local) Docker Compose stack
# (docker-compose.yml). Copy to .env.docker and edit:   cp .env.docker.example .env.docker
#
# This file is short on purpose: local mode has no dashboard, no OAuth handshake
# and no billing — so nothing in .env.example applies here (there is no session
# cookie to sign, no OAuth token to seal, and no API key to reveal — there is no
# API key at all). If you run HOSTED mode instead (docker-compose.prod.yml), the
# container reads .env.prod with the full .env.example set — the Billing block
# at the end of this file documents the OpenCollective variables that apply
# there.
#
# Compose passes these to the container. The one variable it reads for ITSELF
# (AGENTSMEMORY_HOST_PORT, the published host port) must live in your shell or in
# a .env file beside docker-compose.yml — not here.

# --- Reaching the server from another machine ------------------------------
# By default the stack publishes on 127.0.0.1 only (see the ports: block in
# docker-compose.yml), so /mcp is reachable from this host and nowhere else —
# which is what makes an unauthenticated endpoint safe.
#
# To serve other machines on your network, you must do BOTH of these, in this
# order. Widening the publish without setting a token hands every memory in the
# database to anyone on the network:
#   1. Set a token here. The server reads this variable directly, so no change to
#      the command: in docker-compose.yml is needed.
#   2. Widen the publish in docker-compose.yml, e.g. "8080:8080" instead of
#      "127.0.0.1:${AGENTSMEMORY_HOST_PORT:-8080}:8080".
#
# Generate one with:  openssl rand -hex 32
# AGENTSMEMORY_LOCAL_TOKEN=
#
# Agents then register with the token — the same variable name, so exporting it
# once in your shell configures the client side too:
#   aiagentmemory install --local --token "$AGENTSMEMORY_LOCAL_TOKEN" \
#     --mcp-url http://192.168.1.50:8080/mcp

# --- Embeddings: Ollama --------------------------------------------------
# Compose does not run Ollama. Point at wherever yours already is.
#
# Ollama on the host (macOS, Windows, Linux — the compose file maps this name on
# Linux too):
OLLAMA_URL=http://host.docker.internal:11434
#
# Ollama on another machine — a workstation with a GPU, a home server:
# OLLAMA_URL=http://192.168.1.50:11434
# OLLAMA_URL=https://ollama.internal.example.com
#
# TWO THINGS THAT BITE, both on the Ollama side rather than here:
#   1. Ollama binds 127.0.0.1 by default, which a container cannot reach. Start
#      it with OLLAMA_HOST=0.0.0.0 (on macOS: launchctl setenv OLLAMA_HOST
#      0.0.0.0, then restart Ollama; as a systemd service: an override with
#      Environment="OLLAMA_HOST=0.0.0.0").
#   2. The embedding model must be pulled before first use:  ollama pull bge-m3
OLLAMA_EMBED_MODEL=bge-m3

# --- `agentsmemory eval` question generator -------------------------------
# Used ONLY by the eval command; the running server never calls this.
#
# eval writes its own questions — for each sampled drawer a model is asked what
# question that drawer answers — so this model must be GENERATIVE. bge-m3 is an
# embedder and cannot answer /api/generate, so an Ollama holding only embedders
# fails every case with `model '...' not found`:  ollama pull qwen2.5-coder:7b
# EVAL_GEN_MODEL=qwen2.5-coder:7b
#
# Defaults to OLLAMA_URL. Set it to send this one-off burst of LLM work to a
# bigger or hosted model while the vectors stay put. Ollama's own /api/generate
# format, so another Ollama (local, remote or hosted) — NOT an OpenAI-shaped
# /v1/chat/completions endpoint.
# EVAL_GEN_URL=https://ollama.com
# EVAL_GEN_API_KEY=

# --- Vector search: chromem (embedded) ------------------------------------
# chromem is a vector database that runs INSIDE the server process: no second
# container, no network hop, no port. It keeps the vectors in memory and persists
# them to /data/agentsmemory.chromem — the same volume as the database, so one
# backup covers both.
#
# SQLite stays the source of truth; this index is derived, and the server refills
# it from SQLite on boot whenever it is empty. Deleting the .chromem directory is
# therefore a safe way to force a clean rebuild — nothing is re-embedded.
#
# This is also what --local picks on its own; setting it here says it out loud.
VECTOR_BACKEND=chromem

# Two alternatives, both a one-line change:
#   VECTOR_BACKEND=sqlite  — no index at all, the source of truth answers
#     searches itself by scanning. Least memory, slowest queries.
#   VECTOR_BACKEND=qdrant  — a separate Qdrant service, worth it for a large
#     palace or one shared by several machines. The full-stack overlay brings one
#     up and sets these for you (docker-compose.full.yml); set them by hand only
#     if you run Qdrant yourself:
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# --- Reranking (optional) ---------------------------------------------------
# A cross-encoder rescores the best candidates of every search. The embedder
# scores a drawer against a query it never saw; a cross-encoder reads the pair
# together, which is a different and much sharper judgement — bge-m3 and
# bge-reranker-v2-m3 are a matched pair, and this is the second half.
#
# Empty (the default) means search ends at the hybrid vector+BM25 fusion, exactly
# as before. When set, a reranker that is DOWN costs ranking quality and nothing
# else: search falls back to the fused order rather than failing.
#
# The full-stack overlay sets these to a llama.cpp server it runs for you:
#   docker compose -f docker-compose.yml -f docker-compose.full.yml up -d
#
# To point at your own instead — a bare host gets /rerank appended, so this works
# for text-embeddings-inference as-is, and llama.cpp needs its explicit path:
# RERANK_URL=http://reranker:8080/v1/rerank
# RERANK_MODEL=bge-reranker-v2-m3
# RERANK_TOP_K=50

# --- Logging --------------------------------------------------------------
# true = per-request HTTP access logs + every SQL statement. Useful the first
# time an agent connects and you want proof the calls are landing.
APP_DEBUG=false

# --- Billing (hosted mode only; ignored by --local) -------------------------
# Local mode has no billing, so the variables below do nothing here. They matter
# for hosted deployments (docker-compose.prod.yml), where the full .env.example
# applies and the Pro "checkout" is a hosted OpenCollective contribution page:
# set BILLING_PROVIDER=opencollective and the three URLs below. OpenCollective
# sends no signed webhook, so after payment an operator activates the plan:
#   agentsmemory set-plan --slug <workspace> --plan pro_monthly
# See .env.example for the full block.
# BILLING_PROVIDER=opencollective
# OPENCOLLECTIVE_CHECKOUT_PRO_MONTHLY=https://opencollective.com/it-uoga/projects/ai-agents-memory/contribute/pro-monthly-104934/checkout
# OPENCOLLECTIVE_CHECKOUT_PRO_ANNUAL=https://opencollective.com/it-uoga/projects/ai-agents-memory/contribute/pro-yearly-104935/checkout
# OPENCOLLECTIVE_PROJECT_URL=https://opencollective.com/it-uoga/projects/ai-agents-memory
