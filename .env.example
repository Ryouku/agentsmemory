# agentsmemory configuration — copy to .env and fill in.
# Real environment variables always override values from .env.

# --- OAuth 2.1 (MCP, for the claude.ai remote connector) ---
# Issuer = the PUBLIC base URL of this server, no trailing slash, no /mcp.
# In production this must be the external https URL.
OAUTH_ISSUER=http://localhost:8080
# Stable secret that seals OAuth access/refresh tokens. Changing it invalidates
# every issued token. Generate one with:  openssl rand -hex 32
OAUTH_SECRET_KEY=

# --- Dashboard session cookie ---
# Signing key for the login session cookie, hex of >= 32 bytes.
# Generate with:  openssl rand -hex 32
AGENTSMEMORY_SESSION_KEY=

# --- API key reveal secret ---
# Seals workspace API keys at rest so the dashboard can reveal them after creation.
# Set it (32+ random chars) to keep keys revealable across restarts; unset uses a
# random per-boot key, so keys minted before a restart become reveal-unavailable.
# Generate with:  openssl rand -hex 32
AGENTSMEMORY_TOKEN_KEY=

# --- Social login (optional; goth) ---
# Only providers whose KEY/SECRET are set appear on the login page.
# PUBLIC_BASE_URL builds the OAuth callback URLs ({base}/auth/{provider}/callback).
PUBLIC_BASE_URL=http://localhost:8080
# GITHUB_KEY=
# GITHUB_SECRET=
# GOOGLE_KEY=
# GOOGLE_SECRET=
# FACEBOOK_KEY=
# FACEBOOK_SECRET=

# --- Platform superadmin (optional) ---
# Comma-separated emails allowed to edit the GLOBAL am_skillset wakeup playbook
# that every tenant shares (the only god-mode surface). Matched case-insensitively
# against the signed-in user's email. CLI flag --superadmin-emails overrides this.
# Empty (default) = no superadmin: the global skillset can still be seeded on a
# fresh database, just not edited from the dashboard.
# SUPERADMIN_EMAILS=you@example.com,colleague@example.com

# --- Analytics (optional) ---
# OpenPanel client id. Set it and every public and dashboard page renders the
# OpenPanel tracking snippet in its <head>; leave it unset (the default) and no
# tracker is emitted at all — which is what keeps a self-hosted install from
# reporting to a third party nobody chose.
#
# The client id ONLY. OpenPanel's browser SDK authenticates events with the id,
# while the account's client secret belongs to their server-side/export API — and
# anything rendered into a document head is public, so the secret must never be
# set here. If you later add server-side event ingest, read the secret in the
# server process and keep it out of the views package.
# OPENPANEL_CLIENT_ID=

# --- Billing (subscriptions: Pro monthly €50 / annual €500) ---
# Optional, and single-provider per deployment. Pick ONE backend with
# BILLING_PROVIDER; only that provider's keys need values. With the active
# provider's settings unset, billing is inert and the dashboard shows no
# upgrade button. The plan catalog (€50/mo, €500/yr, EUR) is seeded by migration —
# only the provider's price ids / checkout URLs (which differ test vs live) live here.
# BILLING_PROVIDER=stripe            # stripe (default) | opencollective

# Stripe (BILLING_PROVIDER=stripe): secret key + webhook signing secret, plus the
# Stripe Price id backing each plan. Webhook endpoint: {PUBLIC_BASE_URL}/webhooks/stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=

# OpenCollective (BILLING_PROVIDER=opencollective): donations platform — the Pro
# "checkout" is a hosted contribution page on the project's Open Collective, so no
# API credentials are needed, only the per-plan contribution-checkout URLs.
#   OPENCOLLECTIVE_CHECKOUT_PRO_MONTHLY  Contribution-checkout URL of the €50/month tier.
#   OPENCOLLECTIVE_CHECKOUT_PRO_ANNUAL   Contribution-checkout URL of the €500/year tier.
#   OPENCOLLECTIVE_PROJECT_URL           Project page — the manage/cancel surface
#                                        (OpenCollective has no customer-portal API).
# OpenCollective sends no signed webhook, so after payment an operator activates
# the plan:  agentsmemory set-plan --slug <workspace> --plan pro_monthly
# (OpenCollective webhooks are Slack/Discord-style notifications, not verifiable callbacks).
# OPENCOLLECTIVE_CHECKOUT_PRO_MONTHLY=https://opencollective.com/it-uoga/projects/ai-agents-memory/contribute/pro-monthly-104934/checkout
# OPENCOLLECTIVE_CHECKOUT_PRO_ANNUAL=https://opencollective.com/it-uoga/projects/ai-agents-memory/contribute/pro-yearly-104935/checkout
# OPENCOLLECTIVE_PROJECT_URL=https://opencollective.com/it-uoga/projects/ai-agents-memory

# --- Server ---
# HTTP listen address and SQLite database path. CLI flags --addr / --db override
# these; both fall back to the built-in defaults when unset.
AGENTSMEMORY_ADDR=:8080
AGENTSMEMORY_DB=agentsmemory.db
# Verbose logging: per-request HTTP access logs (chi) + gorm SQL. Off by default
# (the server is intentionally quiet); set true to see traffic during dev.
# Overridable with --debug.
APP_DEBUG=false

# --- Read-only `mcp` CLI (optional) ---
# An API key for the `agentsmemory mcp` subcommand so a local read resolves a
# tenant and meters like the HTTP path. Only the CLI reads it; the server does
# not. CLI flag --token overrides this. Leave unset unless you use that CLI.
# AGENTSMEMORY_TOKEN=

# --- Vector storage (SQLite source of truth + a search index over it) --------
# SQLite always stores every vector durably (the source of truth). VECTOR_BACKEND
# picks what answers search, and switching only costs an index rebuild:
#   sqlite  — the SQLite store also serves search (brute force, no external
#             service); the easy default for local dev.
#   chromem — an embedded vector DB inside this process: vectors in memory,
#             persisted next to the database (agentsmemory.db ->
#             agentsmemory.chromem/). No service to run; --local picks it by
#             default. Delete that directory to force a rebuild from SQLite.
#   qdrant  — SQLite stays the source of truth and Qdrant is the search index.
VECTOR_BACKEND=sqlite
# Qdrant connection (only used when VECTOR_BACKEND=qdrant).
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Embeddings (Ollama) ---
# Ollama server that turns drawer text into vectors. bge-m3 is 1024-dimensional.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

# --- `agentsmemory eval` question generator ---
# Only used by the eval command; the running server never calls this.
#
# eval writes its own questions: for each sampled drawer a model is asked what
# question that drawer answers, which is what makes labelling free. That model
# must be GENERATIVE — bge-m3 and nomic-embed-text are embedders and cannot
# answer /api/generate, so a palace whose Ollama holds only embedders fails every
# case with `model '...' not found` until one is pulled (`ollama pull
# qwen2.5-coder:7b`).
# EVAL_GEN_MODEL=qwen2.5-coder:7b
#
# Where to generate. Defaults to OLLAMA_URL, so a single-machine setup sets
# nothing. Set it to send this one-off burst of LLM work to a bigger or hosted
# model while your vectors stay on the local box — the embedder is unaffected.
# The wire format is Ollama's own /api/generate, so this accepts another Ollama
# (local, remote, or hosted), NOT an OpenAI-shaped /v1/chat/completions endpoint.
# EVAL_GEN_URL=https://ollama.com
# EVAL_GEN_API_KEY=

# --- Ranking knobs -----------------------------------------------------------
# Lexical fusion weight: 'auto' (default) scales BM25 per query by how much
# lexical signal the query carries against the candidates; a fixed 0..1 pins it.
# BM25_WEIGHT=auto
#
# 'auto-idf' is 'auto' with each query term weighted by how much it
# discriminates, instead of counted once. The binary count reads a term
# appearing in nearly every candidate as lexical signal — which is exactly when
# BM25 is noise — and auto-idf is ahead on every table measured so far (four,
# across two unrelated corpora). It is not the default only because a ranking
# default changes what every existing palace returns.
# BM25_WEIGHT=auto-idf
#
# Closet curation prior, 0..1. Closets summarise mined sources, and their boost
# promotes drawers from sources a search's closet hits point at. On a curated
# palace that prior helps; on a corpus dominated by raw mined transcripts the
# eval measured the same boost DEMOTING correct answers (~0.10 MRR) — the
# closets cover the curated slice and lift it over the mined gold. Set 0 to
# turn the prior (and its per-search closet lookup) off.
# CLOSET_BOOST=1
#
# How vector and lexical evidence combine: 'linear' (default, weighted by
# BM25_WEIGHT) or 'rrf' (reciprocal-rank fusion). A linear blend lets one bad
# signal drag a good candidate down; on a large diverse palace BM25 measured
# BELOW vector alone, and since the cross-encoder's pool is taken off the fused
# head, the reranker never saw what fusion had buried. RRF was the best arm
# there. Run `agentsmemory eval` on your own corpus before switching — the rrf
# arm in its table is exactly this question.
# FUSION=linear

